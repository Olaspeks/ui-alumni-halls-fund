# =====================================================================
# UI Alumni Halls Fund — environment variables
#
# Copy to .env.local and fill in as you go. EVERY variable below is
# optional for local development: anything left blank runs in mock
# mode automatically (see lib/config.ts). No code changes are needed
# to go from fully-mocked to fully-live — only these values.
# =====================================================================

# --- Supabase (database, auth, realtime) --------------------------------
# Required for /admin and /account (real logins). The public giving page
# runs on static demo data if these are left blank.
# Get these from: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (NGN donations) -------------------------------------------
# Get test keys from: Paystack dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Stripe (USD donations) ----------------------------------------------
# Get test keys from: Stripe dashboard -> Developers -> API keys
# Webhook secret from: Stripe dashboard -> Developers -> Webhooks -> Add endpoint
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (email receipts) ---------------------------------------------
# Get a key from: resend.com -> API Keys. Without it, receipts are logged
# to the server console instead of emailed, and are still viewable in-app.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL="UI Alumni Halls Fund <receipts@yourdomain.org>"

# --- Cloudflare Turnstile (bot protection on the donation form) ---------
# Get keys from: dash.cloudflare.com -> Turnstile. Without them, the
# donation form always passes (mock mode) — fine for local/demo, not for
# production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Blockchain confirmation stamp (Polygon Amoy testnet by default) ----
# See contracts/README.md for how to deploy and fund a testnet wallet.
# Without these, confirmation stamping is skipped and logged as mocked —
# it never blocks a donation either way (fire-and-forget by design).
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=
CHAIN_CONTRACT_ADDRESS=
CHAIN_EXPLORER_TX_BASE_URL=https://amoy.polygonscan.com/tx/

# --- App-level ------------------------------------------------------------
# Public base URL, used in emailed receipt links. Set this to your real
# https://<project>.vercel.app URL in production — do not leave it as
# localhost outside of local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the self-contained "mock mode" receipt tokens used when Supabase
# isn't configured yet, so a demo receipt link can't be forged into
# claiming a fake donation amount. Any long random string is fine; change
# it in production.
RECEIPT_TOKEN_SIGNING_SECRET=change-me-to-a-long-random-string
